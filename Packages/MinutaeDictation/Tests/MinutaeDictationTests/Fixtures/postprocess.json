      "entries": [
        {"id": "sig", "term": "sig", "replacement": "Thanks,\nAlex", "kind": "snippet"}
      ]
    },
    {
      "name": "snippet-not-inside-word",
      "input": "signal",
      "expected": "Signal.",
      "entries": [
        {"id": "sig", "term": "sig", "replacement": "Thanks,\nAlex", "kind": "snippet"}
      ]
    },
    {
      "name": "longer-snippet-beats-shorter-word",
      "input": "send my email",
      "expected": "Send ada@example.com.",
      "entries": [
        {"id": "email", "term": "email", "replacement": "inbox", "kind": "word"},
        {"id": "mine", "term": "my email", "replacement": "ada@example.com", "kind": "snippet"}
      ]
    },
    {
      "name": "disabled-entry-is-ignored",
      "input": "the cat",
