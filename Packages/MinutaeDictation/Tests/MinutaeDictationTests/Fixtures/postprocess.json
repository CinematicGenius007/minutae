          "enabled": false
        }
      ]
    },
    {
      "name": "app-snippet",
      "input": "brb",
      "bundleID": "com.tinyspeck.slackmacgap",
      "expected": "Back shortly.",
      "entries": [
        {"id": "global", "term": "brb", "replacement": "be right back", "kind": "word"},
        {
          "id": "slack",
          "term": "brb",
          "replacement": "back shortly",
