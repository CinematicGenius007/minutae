      ]
    },
    {
      "name": "longest-phrase",
      "input": "visit new york and york",
      "expected": "Visit NYC and Yorkshire.",
      "entries": [
        {"id": "city", "term": "new york", "replacement": "NYC", "kind": "word"},
        {"id": "shire", "term": "york", "replacement": "Yorkshire", "kind": "word"}
      ]
    },
    {
      "name": "phrase-does-not-eat-longer-word",
      "input": "new yorkshire",
      "expected": "New yorkshire.",
      "entries": [
        {"id": "city", "term": "new york", "replacement": "NYC", "kind": "word"},
        {"id": "shire", "term": "york", "replacement": "Yorkshire", "kind": "word"}
      ]
    },
    {
      "name": "term-whitespace-is-normalized",
      "input": "visit new york",
      "expected": "Visit NYC.",
      "entries": [
        {"id": "city", "term": "new  york", "replacement": "NYC", "kind": "word"}
      ]
    },
    {
      "name": "brand-replacement-keeps-camel-case",
      "input": "ebay arrived",
      "expected": "eBay arrived.",
      "entries": [
        {"id": "ebay", "term": "ebay", "replacement": "eBay", "kind": "word"}
      ]
    },
    {
      "name": "snippet",
      "input": "sig",
