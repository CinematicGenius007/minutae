      "entries": [
        {"id": "cat", "term": "cat", "replacement": "dog", "kind": "word"}
      ]
    },
    {
      "name": "dictionary-whole-word-miss",
      "input": "the catalog",
      "expected": "The catalog.",
      "entries": [
        {"id": "cat", "term": "cat", "replacement": "dog", "kind": "word"}
      ]
    },
    {
      "name": "dictionary-whole-word-hit",
      "input": "the cat sat",
