      "entries": [
        {"id": "global", "term": "repo", "replacement": "repository", "kind": "word"},
        {
          "id": "xcode",
          "term": "repo",
          "replacement": "Xcode project",
          "kind": "word",
          "scope": "com.apple.dt.Xcode"
        }
      ]
    },
    {
      "name": "global-when-bundle-is-missing",
      "input": "open the repo",
