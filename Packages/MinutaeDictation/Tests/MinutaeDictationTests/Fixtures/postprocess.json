      "entries": [
        {"id": "cat", "term": "cat", "replacement": "dog", "kind": "word", "enabled": false}
      ]
    },
    {
      "name": "unknown-kind-is-ignored",
      "input": "hello repo",
      "expected": "Hello repo.",
      "entries": [
        {"id": "repo", "term": "repo", "replacement": "repository", "kind": "phrase"}
      ]
    },
    {
      "name": "empty-term-is-ignored",
      "input": "hello",
      "expected": "Hello.",
      "entries": [
        {"id": "blank", "term": "   ", "replacement": "nope", "kind": "word"}
      ]
    },
    {
