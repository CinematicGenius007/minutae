<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements (the app is not sandboxed, so com.apple.security.network.*
  and other App Sandbox keys do not apply and are left out).

  - audio-input: microphone (meetings + dictation). System audio uses a Core Audio process
    tap, which needs NSAudioCaptureUsageDescription in Info.plist, not an entitlement.
  - automation.apple-events: tauri-plugin-updater runs an in-process AppleScript
    ("do shell script … with administrator privileges") when the app's folder is not
    writable by the user. Without it that one path fails under the hardened runtime.

  Not needed: JIT / unsigned memory (WebKit's JIT lives in Apple's WebContent process) and
  disable-library-validation (whisper.cpp and sherpa-onnx/onnxruntime are linked
  statically; the binary loads no third-party dylibs — check with `otool -L`).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
